# Local demo needs no provider credentials. run.py binds to 127.0.0.1 by default.
# Set a strong operator token before exposing the service beyond your machine.
RELAYLA_OPERATOR_TOKEN=
RELAYLA_DB_PATH=.data/relayla.sqlite3

# Optional live browser voice. Use published agents with the supplied tools.
RETELL_API_KEY=
RETELL_AGENT_ID_EN=
RETELL_AGENT_ID_ES=
# Optional comma-separated additional inbound agent IDs allowed to use tools.
RETELL_ALLOWED_AGENT_IDS=

# Disabled by default. Enable only after setting an operator token and configuring
# Retell webhook/function URLs plus raw-body signature verification.
RELAYLA_ENABLE_RETELL=false
