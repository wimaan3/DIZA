    "check": "prettier --check src tests *.js *.mjs ../diza_analysis/relay_web/*.html ../diza_analysis/relay_web/relay.css ../diza_analysis/relay_web/coordinator.js ../diza_analysis/relay_web/resident.js ../diza_analysis/relay_web/local.js ../diza_analysis/relay_web/sw.js"
  },
  "dependencies": {
