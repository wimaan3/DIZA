{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "sessions/ds-analytics/deploy/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health/analysis",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
