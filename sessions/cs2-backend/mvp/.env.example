DRILL_MODE=true
OFFER_TIMEOUT_SECONDS=30
RETELL_API_KEY=
OPS_API_TOKEN=
# Not connected in this MVP; reserved for future Supabase adapter
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Human-in-the-loop responders for route_to_human (real phones: set in your shell/secrets, never commit)
# DIZA_RESPONDERS=[{"id":"t1","name":"Teammate","phone":"+1...","skills":"evac_logistics,medical,lang:en"}]
DIZA_RESPONDERS=
# Form schemas for start_form/fill_form/submit_form (defaults to <repo>/agents/forms)
FORMS_DIR=
# Verified places/hotlines for lookup_info (defaults to <repo>/agents/resources/resources.yaml)
RESOURCES_FILE=
# Approved alerts -> automated calls (backend/app/alerts.py)
RETELL_FROM_NUMBER=
RETELL_ALERT_AGENT_ID=agent_...   # the `alert` agent id from agents/retell.ids.json
# Opted-in contacts CSV (name,phone,language[,opted_out]) - real numbers, never commit
ALERT_CONTACTS_FILE=
# Leave false during the hackathon: only drills
ALLOW_LIVE_ALERTS=false
