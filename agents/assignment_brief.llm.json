{
  "_prompt_files": [
    "assignment_brief.md"
  ],
  "_tools": [
    "respond_assignment",
    "end_call"
  ],
  "model": "gpt-4.1-mini",
  "model_temperature": 0.1,
  "tool_call_strict_mode": true,
  "start_speaker": "agent",
  "begin_message": "{{drill_prefix}}This is the ${LINE_NAME}, an automated line, with a request for {{responder_name}}. {{briefing}} Can you take it?",
  "default_dynamic_variables": {
    "line_name": "${LINE_NAME}",
    "responder_name": "there",
    "briefing": "",
    "severity": "P2",
    "assignment_id": "",
    "drill_prefix": ""
  }
}
