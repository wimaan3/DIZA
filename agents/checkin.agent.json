{
  "agent_name": "diza-checkin-outbound",
  "voice_id": "cartesia-Cleo",
  "voice_model": "sonic-3",
  "language": [
    "en-US",
    "es-419",
    "ko-KR",
    "zh-CN",
    "vi-VN",
    "ru-RU",
    "ja-JP",
    "ar-SA",
    "hi-IN",
    "th-TH",
    "uk-UA",
    "fr-FR",
    "pt-BR",
    "de-DE",
    "it-IT",
    "he-IL",
    "ta-IN",
    "id-ID",
    "tr-TR",
    "pl-PL"
  ],
  "webhook_url": "${BASE_URL}/retell/webhook",
  "webhook_events": [
    "call_started",
    "call_ended",
    "call_analyzed",
    "transcript_updated",
    "transfer_started",
    "transfer_bridged",
    "transfer_cancelled",
    "transfer_ended"
  ],
  "webhook_timeout_ms": 10000,
  "interruption_sensitivity": 0.75,
  "responsiveness": 1,
  "enable_backchannel": true,
  "reminder_trigger_ms": 8000,
  "reminder_max_count": 2,
  "denoising_mode": "noise-cancellation",
  "boosted_keywords": [
    "humo",
    "fuego",
    "incendio",
    "atrapado",
    "atrapada",
    "oxígeno",
    "inundación",
    "huele a gas",
    "no puedo respirar",
    "inconsciente",
    "Altadena",
    "Lake Avenue",
    "Pasadena",
    "Eaton",
    "USC",
    "Leavey",
    "Doheny",
    "Tommy Trojan",
    "988",
    "911"
  ],
  "allow_user_dtmf": true,
  "data_storage_setting": "everything_except_pii",
  "data_storage_retention_days": 7,
  "pii_config": {
    "mode": "post_call",
    "categories": [
      "ssn",
      "credit_card",
      "bank_account",
      "password",
      "pin",
      "passport",
      "driver_license"
    ]
  },
  "post_call_analysis_model": "gpt-4.1-mini",
  "max_call_duration_ms": 600000,
  "end_call_after_silence_ms": 30000,
  "voicemail_option": {
    "action": {
      "type": "static_text",
      "text": "Hi, this is the ${LINE_NAME} with your check-in call. We'll try again soon. If you need anything, call us back at this number. If it's an emergency, call 911."
    }
  },
  "post_call_analysis_data": [
    {
      "type": "enum",
      "name": "wellbeing",
      "description": "How the person is doing.",
      "choices": [
        "ok",
        "concern",
        "urgent",
        "no_answer",
        "opted_out"
      ]
    },
    {
      "type": "boolean",
      "name": "needs_followup",
      "description": "True if a person on our team should follow up with this caller."
    },
    {
      "type": "string",
      "name": "needs_mentioned",
      "description": "Needs the person mentioned (food, medicine, ride, help at home), or empty."
    },
    {
      "type": "boolean",
      "name": "consent_confirmed",
      "description": "True if a pending-consent person agreed to check-ins on this call."
    },
    {
      "type": "enum",
      "name": "language",
      "description": "Language the caller mainly used.",
      "choices": [
        "en",
        "es",
        "ko",
        "zh",
        "hy",
        "tl",
        "other"
      ]
    },
    {
      "type": "enum",
      "name": "outcome",
      "description": "How the call ended.",
      "choices": [
        "ai_resolved",
        "human_transferred",
        "callback_queued",
        "safety_911_988",
        "abandoned",
        "voicemail"
      ]
    }
  ],
  "contact_memory_config": {
    "enable_read": false,
    "enable_update": false
  },
  "handbook_config": {
    "high_empathy": true,
    "speech_normalization": true,
    "echo_verification": true,
    "ai_disclosure": false
  },
  "guardrail_config": {
    "input_topics": [
      "platform_integrity_jailbreaking"
    ]
  },
  "allow_dtmf_interruption": true,
  "user_dtmf_options": {
    "timeout_ms": 2000
  },
  "pronunciation_dictionary": [
    {
      "word": "Altadena",
      "alphabet": "ipa",
      "phoneme": "ˌæltəˈdiːnə"
    },
    {
      "word": "Doheny",
      "alphabet": "ipa",
      "phoneme": "doʊˈhiːni"
    },
    {
      "word": "Leavey",
      "alphabet": "ipa",
      "phoneme": "ˈliːvi"
    },
    {
      "word": "Eaton",
      "alphabet": "ipa",
      "phoneme": "ˈiːtən"
    }
  ],
  "begin_message_delay_ms": 800,
  "ivr_option": {
    "action": {
      "type": "hangup"
    }
  }
}
